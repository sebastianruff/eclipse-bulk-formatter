Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Format incl. Subpackages
Bundle-SymbolicName: io.github.sebastianruff.bulkformatter;singleton:=true
Bundle-Version: 1.1.0.qualifier
Bundle-Vendor: Sebastian Ruff
Bundle-RequiredExecutionEnvironment: JavaSE-21
Automatic-Module-Name: io.github.sebastianruff.bulkformatter
Bundle-ActivationPolicy: lazy
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.core.filebuffers,
 org.eclipse.jdt.core,
 org.eclipse.text,
 org.eclipse.jface.text,
 org.eclipse.ui,
 org.eclipse.ui.ide,
 org.eclipse.ui.editors,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.lsp4e;resolution:=optional,
 org.eclipse.lsp4j;resolution:=optional,
 org.eclipse.lsp4j.jsonrpc;resolution:=optional
Export-Package: io.github.sebastianruff.bulkformatter
Bundle-License: EPL-2.0;link="https://www.eclipse.org/legal/epl-2.0/"
